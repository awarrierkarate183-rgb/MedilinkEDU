# Copy this file to .env.local. Never commit real keys.

# Required for the authenticated portal. The public website runs without these.
NEXT_PUBLIC_SUPABASE_URL=

# Browser / RLS-scoped key. Either name is accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Either name is accepted. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin for chapter QR codes, invitation links, and password reset.
# Local: http://localhost:3000
# Production: https://medilink-edu.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only on a local or isolated development project.
# Never enable this against production.
MEDILINK_ALLOW_DEV_SEED=false

# Optional. Used to email student invites automatically.
# Gmail app passwords also work through SMTP_USER + SMTP_PASS.
RESEND_API_KEY=
EMAIL_FROM=MediLink <medi.link.edu@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
