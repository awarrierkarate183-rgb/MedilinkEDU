# Copy this file to .env.local. Never commit real keys.

# Required for the authenticated portal. The public website runs without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this in client code or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for chapter QR codes and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only on a local or isolated development project.
# Never enable this against production.
MEDILINK_ALLOW_DEV_SEED=false
